# a setup saved by 1.0.4 / 1.0.5 (format 2) loads in 1.0.6: the instrument keeps its name although Kokyu was put
# before Taiko (Bamboo Flt stays 5, Taiko 6 becomes 7), Trill feel takes its new default, the trill's defaults appear
store_v2 5
reboot
wait 100
expect par7 5
store_v2 6
reboot
wait 100
expect par7 7
expect par15 100
expect par44 42
expect par48 0
# what 1.0.6 saves loads as it is
spin PRESET -1
tap SAVE
wait 50
reboot
wait 100
expect par7 6
